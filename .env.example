# Copy to .env.local — never commit real values.
# The anon key is safe to ship to the browser; the service role key is NOT and lives only in Edge Function secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Risip's official WhatsApp number, digits only, no '+'. Only used to build the
# wa.me linking deep link. The WhatsApp access token and app secret are server-side
# Edge Function secrets and must never appear in a VITE_* variable.
# See docs/whatsapp-setup.md.
VITE_RISIP_WHATSAPP_NUMBER=255XXXXXXXXX
