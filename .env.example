# Copy to .env.local — never commit real values.
#
# The API is self-hosted and served from the same host as the app, so a
# relative base works on every domain the app is deployed to (risip.online,
# admin.risip.online, a preview host) without a rebuild.
VITE_SUPABASE_URL=/api

# The self-hosted API does not check this key — it exists so the call sites
# keep working unchanged. Any non-empty value will do.
VITE_SUPABASE_ANON_KEY=risip-self-hosted

# Risip's official WhatsApp number, digits only, no '+'. Only used to build the
# wa.me linking deep link. The WhatsApp access token and app secret are server-side
# secrets and must never appear in a VITE_* variable.
# See docs/whatsapp-setup.md.
VITE_RISIP_WHATSAPP_NUMBER=255XXXXXXXXX

# Server-side WhatsApp credentials. Never prefix these with VITE_.
# These are read by the PHP API and the WhatsApp worker, not by the browser.
WHATSAPP_ACCESS_TOKEN=server-only-meta-token
WHATSAPP_PHONE_NUMBER_ID=meta-phone-number-id
META_GRAPH_VERSION=v22.0
RISIP_PUBLIC_APP_URL=https://risip.online
LOGIN_RATE_LIMIT_SECRET=at-least-32-random-bytes
WHATSAPP_LOGIN_TEMPLATE=risip_login_link
WHATSAPP_ONBOARDING_TEMPLATE=risip_start_onboarding
