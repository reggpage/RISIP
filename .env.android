# Read by `vite build --mode android` (the `app:build` script).
#
# The Android package loads its web assets from the device, so a relative API
# base would point at the device's own localhost. The package therefore talks
# to the public API over HTTPS.
VITE_SUPABASE_URL=https://risip.online/api

# The self-hosted API does not check this key — any non-empty value will do.
VITE_SUPABASE_ANON_KEY=risip-self-hosted
